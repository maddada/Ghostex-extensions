{
  "name": "ghostex-extension-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build and test tooling for the Ghostex Canvas extension.",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "sideload": "npm run build && node sideload.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "perfect-freehand": "1.2.3",
    "preact": "10.29.8",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
