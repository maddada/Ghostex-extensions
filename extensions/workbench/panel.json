{
  "$schema": "../../schemas/ghostex-sidebar-panel.schema.json",
  "schema": 1,
  "tabs": [
    { "id": "map", "title": "Map", "icon": "map" },
    { "id": "focus", "title": "Focus", "icon": "focus-2" }
  ],
  "blocks": [
    {
      "id": "projects",
      "type": "empty",
      "tab": "map",
      "title": "Reading your projects…",
      "icon": "loader2"
    },
    {
      "id": "today",
      "type": "checklist",
      "tab": "focus",
      "title": "Today",
      "editable": true,
      "items": [
        { "id": "welcome", "text": "Add what you want done today", "done": false }
      ]
    },
    {
      "id": "week",
      "type": "progress",
      "tab": "focus",
      "title": "Today's progress",
      "value": 0,
      "max": 1,
      "label": "Done today"
    },
    {
      "id": "refresh",
      "type": "buttons",
      "tab": "map",
      "items": [{ "title": "Refresh", "icon": "refresh", "action": { "extension": "refresh" } }]
    }
  ]
}
