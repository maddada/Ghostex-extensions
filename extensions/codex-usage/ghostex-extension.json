{
  "$schema": "../../schemas/ghostex-extension.schema.json",
  "name": "codex-usage",
  "title": "Codex Usage",
  "description": "Live Codex five-hour and weekly limits with pinned usage badges.",
  "version": "0.1.0",
  "author": "Ghostex",
  "icon": "icon.svg",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "placements": [
    "popup"
  ],
  "defaultPlacement": "popup",
  "server": {
    "command": "node server.mjs --port {port}",
    "cwd": ".",
    "readiness": {
      "httpGet": "/",
      "timeoutSeconds": 30
    }
  },
  "popup": {
    "width": 380,
    "height": 300
  },
  "permissions": [
    "network"
  ]
}
